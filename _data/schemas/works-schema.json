{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/Root",
    "definitions": {
        "Root": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "content": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Content"
                    }
                }
            },
            "required": [
                "content"
            ],
            "title": "Root"
        },
        "Content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "category": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "single_column": {
                    "type": "boolean"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Item"
                    }
                }
            },
            "required": [
                "category",
                "description",
                "items",
                "single_column",
                "title"
            ],
            "title": "Content"
        },
        "Item": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string"
                },
                "cover": {
                    "type": "string"
                },
                "imagebar": {
                    "$ref": "#/definitions/Imagebar"
                },
                "title": {
                    "type": "string"
                },
                "client": {
                    "$ref": "#/definitions/Client"
                },
                "role": {
                    "type": "string"
                },
                "objective": {
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "delivered": {
                    "anyOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "subtitle": {
                    "type": "string"
                },
                "work_done": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "where_to_play": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/WhereToPlay"
                    }
                },
                "highlight_video": {
                    "type": "string"
                },
                "highlight-video": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "role",
                "subtitle",
                "title",
                "work_done"
            ],
            "title": "Item"
        },
        "Client": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "format": "uri",
                    "qt-uri-protocols": [
                        "https"
                    ]
                }
            },
            "required": [
                "name"
            ],
            "title": "Client"
        },
        "Imagebar": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "videos": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Video"
                    }
                },
                "images": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [],
            "title": "Imagebar"
        },
        "Video": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string"
                },
                "autoplay": {
                    "type": "boolean"
                }
            },
            "required": [
                "autoplay",
                "url"
            ],
            "title": "Video"
        },
        "WhereToPlay": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri",
                    "qt-uri-protocols": [
                        "https"
                    ]
                },
                "icon": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "icon",
                "name",
                "url"
            ],
            "title": "WhereToPlay"
        }
    }
}
